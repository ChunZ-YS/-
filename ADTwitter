#!name=Twitter 去广告
#!desc=移除时间线 / 搜索页常见广告（Promoted）
#!author=ChatGPT
#!icon=https://abs.twimg.com/icons/apple-touch-icon-192x192.png

[Rule]
# 广告与推广请求
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,ads-api.twitter.com,REJECT
DOMAIN-SUFFIX,scribe.twitter.com,REJECT

# X 新广告域
DOMAIN-SUFFIX,ads.x.com,REJECT

[Script]
# 时间线 Promoted 推文过滤
http-response ^https:\/\/(api|api\.x)\.twitter\.com\/2\/timeline\/(home|list|search).* script-path=twitter_adblock.js, requires-body=true, timeout=10

# 搜索页广告
http-response ^https:\/\/(api|api\.x)\.twitter\.com\/2\/search\/adaptive.* script-path=twitter_adblock.js, requires-body=true, timeout=10

[MITM]
hostname = api.twitter.com, api.x.twitter.com
