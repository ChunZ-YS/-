let body = $response.body;
if (!body) $done({});

try {
  const obj = JSON.parse(body);

  // 只处理 timeline instructions
  const timeline =
    obj?.data?.home?.home_timeline_urt ||
    obj?.data?.search?.timeline ||
    obj?.data?.list?.timeline;

  if (timeline?.instructions) {
    timeline.instructions.forEach(ins => {
      if (Array.isArray(ins.entries)) {
        ins.entries = ins.entries.filter(e => {
          if (!e) return true;

          // entryId 含 promoted
          if (e.entryId && /promoted/i.test(e.entryId)) return false;

          // 推文级广告标记
          const content = e.content;
          if (
            content?.itemContent?.promotedMetadata ||
            content?.itemContent?.adMetadata
          ) {
            return false;
          }

          return true;
        });
      }
    });
  }

  body = JSON.stringify(obj);
} catch (e) {
  // 出错直接放行
}

$done({ body });
